# Local development / local `npm run start` (copy this file to .env.local)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5000
API_BASE_URL=http://127.0.0.1:5000

# Self-hosted production (nginx → app on :443, API on localhost only):
# NEXT_PUBLIC_APP_URL=https://app.pcsmonthlypla.online
# API_BASE_URL=http://127.0.0.1:5000
# Browser uses same-origin /api/* routes; API port is not exposed publicly.

# Vercel / public API subdomain (optional):
# NEXT_PUBLIC_API_BASE_URL=https://api.pcsmonthlypla.online
# API_BASE_URL=https://api.pcsmonthlypla.online
